# Environment untuk API PGM (apps/api-pgm)
# Salin ke /opt/aisi/apps/api-pgm/.env
# Jangan memakai database AISI (aisi_db / dakwah_db) atau JWT secret AISI.

APP_ENV=production
PORT=4001

DATABASE_URL=postgresql://pgm_user:GANTI_PASSWORD_KUAT@127.0.0.1:5432/pgm_db

JWT_SECRET=GANTI_DENGAN_SECRET_PGM_MIN_32_KARAKTER
JWT_REFRESH_SECRET=GANTI_DENGAN_REFRESH_SECRET_PGM_MIN_32_KARAKTER
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

ALLOWED_ORIGIN=https://pgm.binaisi.xyz
APP_URL=https://pgm.binaisi.xyz

R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=pgm-uploads
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

RESEND_API_KEY=re_your_resend_api_key
# Pakai domain yang sudah verified di Resend. Yang diganti hanya nama tampilan.
EMAIL_FROM="PGM <noreply@contact.binaisi.xyz>"
INVITATION_EXPIRE_DAYS=7

# Bootstrap: bash deploy/deploy-pgm.sh --seed
# SEED_SUPERADMIN_EMAIL=anda@email.com
# SEED_PASSWORD_SUPERADMIN=minimal_12_karakter
# SEED_SUPERADMIN_NAME=Super Admin
