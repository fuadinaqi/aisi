# Environment untuk Go API (apps/api-go)
# Salin ke /opt/aisi/apps/api-go/.env atau export sebelum PM2
# Nama variabel kompatibel dengan Express lama

APP_ENV=production
PORT=4000

DATABASE_URL=postgresql://aisi_user:GANTI_PASSWORD_KUAT@127.0.0.1:5432/aisi_db

JWT_SECRET=GANTI_DENGAN_SECRET_ACAK_MIN_32_KARAKTER
JWT_REFRESH_SECRET=GANTI_DENGAN_REFRESH_SECRET_ACAK_MIN_32_KARAKTER
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Origin frontend (bukan URL API). Wajib match exact, termasuk https.
ALLOWED_ORIGIN=https://binaisi.xyz
APP_URL=https://binaisi.xyz

R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=aisi-uploads
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

RESEND_API_KEY=re_your_resend_api_key
# Domain pengirim harus sudah Verified di Resend (contoh: contact.binaisi.xyz)
EMAIL_FROM=AISI <noreply@contact.binaisi.xyz>
INVITATION_EXPIRE_DAYS=7
