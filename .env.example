# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql://dakwah_user:dakwah_pass@localhost:5432/dakwah_db

# ─── API Go (apps/api-go/.env) ───────────────────────────────
APP_ENV=development
PORT=4000

# JWT
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Cloudflare R2 (Object Storage) — wajib di produksi
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=aisi-uploads
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# CORS (origin Vite)
ALLOWED_ORIGIN=http://localhost:5173

# Email
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@dakwah-depok.id
APP_URL=http://localhost:5173

# Invitation
INVITATION_EXPIRE_DAYS=7

# ─── Web Vite (apps/web-vite/.env) ───────────────────────────
VITE_API_URL=http://localhost:4000/api/v1
