{
  "name": "dakwah-depok",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @dakwah/web-vite dev",
    "build": "pnpm build:web-vite && pnpm build:api-go",
    "lint": "turbo lint",
    "dev:web-vite": "pnpm --filter @dakwah/web-vite dev",
    "dev:api": "cd apps/api-go && go run ./cmd/server",
    "dev:db": "node scripts/dev-db.mjs",
    "dev:stop": "kill-port 4000 5173",
    "dev:stack": "pnpm dev:db && concurrently -k -n api,web -c blue,green \"pnpm dev:api\" \"pnpm dev:web-vite\"",
    "dev:restart": "pnpm dev:stop && pnpm dev:stack",
    "build:web-vite": "pnpm --filter @dakwah/web-vite build",
    "build:api-go": "cd apps/api-go && go build -o bin/aisi-api ./cmd/server",
    "db:generate": "pnpm --filter @dakwah/shared db:generate",
    "db:migrate": "pnpm --filter @dakwah/shared db:migrate",
    "db:deploy": "pnpm --filter @dakwah/shared db:deploy",
    "db:seed": "pnpm --filter @dakwah/shared db:seed",
    "db:seed:prod": "pnpm --filter @dakwah/shared db:seed:prod",
    "db:studio": "pnpm --filter @dakwah/shared db:studio",
    "test:e2e": "pnpm --filter @dakwah/web-vite test:e2e",
    "test:e2e:p0": "pnpm --filter @dakwah/web-vite test:e2e:p0",
    "test:e2e:p1": "pnpm --filter @dakwah/web-vite test:e2e:p1",
    "test:e2e:p2": "pnpm --filter @dakwah/web-vite test:e2e:p2"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "kill-port": "^2.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
